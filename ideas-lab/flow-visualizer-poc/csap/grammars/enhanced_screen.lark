// Enhanced CSAP Grammar for Complex VN Patterns
// Supports all patterns from regex test cases: Apocalust, Amnesia, AoA Academy, Come Home, etc.

start: screen_definition

screen_definition: SCREEN IDENTIFIER screen_params? ":" _NEWLINE _INDENT screen_body _DEDENT

screen_params: "(" param_list? ")"
param_list: IDENTIFIER ("," IDENTIFIER)*

// Allow optional newlines between body elements (for blank lines between elif/else blocks)
screen_body: (screen_body_item | _NEWLINE)+

screen_body_item: screen_property | screen_element | conditional_element | add_statement

screen_property: modal_property | zorder_property

screen_element: textbutton_element
             | imagebutton_element  
             | button_element
             | hotspot_element
             | imagemap_element
             | layout_element
             | other_element

// ============================================================================
// CONDITIONAL ELEMENTS: if/elif/else statements in screens
// ============================================================================

conditional_element: if_statement

// Allow blank lines between conditional blocks by consuming optional _NEWLINE tokens
if_statement: IF conditional_expression ":" _NEWLINE _INDENT conditional_body _DEDENT elif_statement* else_statement?

elif_statement: ELIF conditional_expression ":" _NEWLINE _INDENT conditional_body _DEDENT

else_statement: ELSE ":" _NEWLINE _INDENT conditional_body _DEDENT

// Flexible conditional expression - accepts various Python expression patterns
// Since we treat conditions as metadata, we don't need perfect parsing
conditional_expression: condition_term (logical_operator condition_term)*

condition_term: NOT? condition_atom

condition_atom: function_call | comparison | IDENTIFIER | parenthesized_condition

function_call: IDENTIFIER "(" function_args? ")"

function_args: function_arg ("," function_arg)*
function_arg: STRING | NUMBER | DECIMAL | IDENTIFIER | dotted_identifier

comparison: IDENTIFIER comparison_operator conditional_value

comparison_operator: "==" | "!=" | "<" | ">" | "<=" | ">="

logical_operator: AND | OR

conditional_value: STRING | NUMBER | DECIMAL | IDENTIFIER | dotted_identifier

parenthesized_condition: "(" conditional_expression ")"

NOT.2: "not"
AND.2: "and"
OR.2: "or"

conditional_body: (conditional_body_item _NEWLINE?)+

conditional_body_item: screen_element | add_statement

// ADD statement support - parse but ignore for flow analysis
add_statement: ADD add_content add_properties?

add_content: STRING | IDENTIFIER | dotted_identifier

// Support for gui.main_menu_background style identifiers
dotted_identifier: IDENTIFIER ("." IDENTIFIER)+

add_properties: add_property+
add_property: property_name (STRING | NUMBER | DECIMAL | IDENTIFIER)

// ============================================================================
// TEXTBUTTON: Supports both simple and complex styled patterns
// ============================================================================

textbutton_element: textbutton_single_line | textbutton_multi_line

// Single-line with flexible property/action order (Futagenesis style)
// Properties first, then action at the end
// Single-line: properties can be before OR after the action
textbutton_single_line: TEXTBUTTON STRING textbutton_property* action_statement textbutton_property*

// Multi-line: textbutton "Text": [properties...] action Jump("dest")
textbutton_multi_line: TEXTBUTTON STRING ":" textbutton_properties? action_statement textbutton_property*

// Content for single-line textbuttons - removed, using direct property list instead
// textbutton_content: textbutton_property | action_statement

// Mixed content allows properties and actions in any order (for multi-line)
textbutton_mixed_content: textbutton_property | action_statement

textbutton_properties: textbutton_property+
textbutton_property: textbutton_specific_property | generic_property

textbutton_specific_property: text_color_property 
                            | text_outlines_property 
                            | text_hover_color_property 
                            | text_hover_outlines_property 
                            | text_size_property 
                            | hover_sound_property 
                            | activate_sound_property
                            | xalign_property
                            | yalign_property
                            | xpos_property
                            | ypos_property
                            | xoffset_property
                            | yoffset_property
                            | xsize_property
                            | ysize_property

// Generic property for any other properties (excluding keywords)
generic_property: property_name (STRING | NUMBER | DECIMAL | IDENTIFIER | list_literal | BOOLEAN)

// Property names that are NOT screen element keywords  
property_name: PROPERTY_IDENTIFIER

// Terminal for property identifiers (excludes keywords)
// Much lower priority than IDENTIFIER
PROPERTY_IDENTIFIER.-1: /(?!textbutton|imagebutton|button|hotspot|add|if|screen|elif|else)[a-zA-Z_][a-zA-Z0-9_]*/

// Textbutton-specific properties (from Apocalust VN)
text_color_property: "text_color" STRING
text_outlines_property: "text_outlines" list_literal
text_hover_color_property: "text_hover_color" STRING  
text_hover_outlines_property: "text_hover_outlines" list_literal
text_size_property: "text_size" (NUMBER | IDENTIFIER)
hover_sound_property: HOVER_SOUND (STRING | IDENTIFIER)
activate_sound_property: "activate_sound" (STRING | IDENTIFIER)

// Common positioning properties
xalign_property: XALIGN (NUMBER | DECIMAL | IDENTIFIER)
yalign_property: YALIGN (NUMBER | DECIMAL | IDENTIFIER)
xpos_property: XPOS (NUMBER | DECIMAL | IDENTIFIER)
ypos_property: YPOS (NUMBER | DECIMAL | IDENTIFIER)
xoffset_property: XOFFSET (NUMBER | DECIMAL | IDENTIFIER)
yoffset_property: YOFFSET (NUMBER | DECIMAL | IDENTIFIER)
xsize_property: XSIZE (NUMBER | DECIMAL | IDENTIFIER)
ysize_property: YSIZE (NUMBER | DECIMAL | IDENTIFIER)

// ============================================================================
// IMAGEBUTTON: Supports single-line, multi-line, and anchor-based patterns
// ============================================================================

imagebutton_element: imagebutton_single_line | imagebutton_multi_line

// Single-line: imagebutton idle "image.png" [properties...] action Jump("dest")
imagebutton_single_line: IMAGEBUTTON imagebutton_properties action_statement

// Multi-line: imagebutton [anchor (0.5, 0.5)]: [properties...] action Jump("dest")
imagebutton_multi_line: IMAGEBUTTON imagebutton_anchor? ":" imagebutton_body

imagebutton_anchor: ANCHOR coordinate_tuple

imagebutton_body: (imagebutton_property | action_statement)+

imagebutton_properties: imagebutton_property+
imagebutton_property: idle_property
                    | hover_property
                    | focus_mask_property
                    | auto_property
                    | at_property
                    | hover_sound_property
                    | xoffset_property
                    | yoffset_property
                    | xalign_property
                    | yalign_property
                    | tooltip_property
                    | generic_property

// Imagebutton-specific properties
idle_property: IDLE string_expression
hover_property: HOVER string_expression
focus_mask_property: FOCUS_MASK BOOLEAN
auto_property: AUTO string_expression
at_property: AT IDENTIFIER
tooltip_property: TOOLTIP ("_(" STRING ")" | STRING)

// String expression: supports simple strings or concatenation
string_expression: string_term ("+" string_term)*
string_term: STRING | IDENTIFIER | dotted_identifier

// ============================================================================
// BUTTON: Generic button element (Battle of the Bulges style)
// ============================================================================

button_element: BUTTON ":" button_body

button_body: (button_property | action_statement)+

button_property: xpos_property 
               | ypos_property
               | xysize_property
               | xsize_property
               | ysize_property
               | modal_property
               | generic_property

xysize_property: XYSIZE coordinate_tuple
modal_property: MODAL BOOLEAN
zorder_property: ZORDER NUMBER

// ============================================================================
// HOTSPOT: Coordinate-based clickable areas
// ============================================================================

hotspot_element: HOTSPOT coordinate_tuple action_statement

coordinate_tuple: "(" tuple_item ("," tuple_item)+ ")"

// Tuple items can be numbers, strings, decimals, identifiers, or booleans
tuple_item: STRING | NUMBER | DECIMAL | IDENTIFIER | BOOLEAN

// ============================================================================
// ACTION STATEMENTS: Support chained actions and any Ren'Py action function
// ============================================================================

action_statement: action_keyword action_sequence

// Support both 'action' and 'clicked' keywords (Babysitter game uses 'clicked')
action_keyword: ACTION | CLICKED

// Action sequence: single action, comma-separated actions, or list-wrapped actions
action_sequence: action_list_wrapped | action_chain

// List-wrapped actions: [Action1(...), Action2(...), ...]
action_list_wrapped: "[" action_chain "]"

// Comma-separated chain of actions: Action1(...), Action2(...), ...
action_chain: generic_action ("," generic_action)*

// Generic action: any function call (Jump, Call, Hide, Show, SetVariable, etc.)
generic_action: jump_action | call_action | other_action

// Flow-relevant actions (we extract these for flow analysis)
jump_action: JUMP "(" STRING ")"
call_action: CALL "(" STRING ")"

// Other actions (we parse but ignore these for flow analysis)
other_action: ACTION_FUNCTION "(" action_arguments? ")"

// Action function names (anything that's not a reserved screen keyword)
// Priority 1 to compete with IDENTIFIER
ACTION_FUNCTION.1: /(?!screen|textbutton|imagebutton|button|hotspot|if|elif|else|menu|label|vbox|hbox|add)[A-Z][a-zA-Z0-9_]*/

// Action arguments: flexible to support various parameter types
action_arguments: action_arg ("," action_arg)*
action_arg: STRING | NUMBER | DECIMAL | IDENTIFIER | BOOLEAN | dotted_identifier

// ============================================================================
// IMAGEMAP: Container for hotspots (basic support)
// ============================================================================

imagemap_element: IMAGEMAP ":" _NEWLINE _INDENT imagemap_body _DEDENT

imagemap_body: (imagemap_line | _NEWLINE)+

imagemap_line: imagemap_property | hotspot_element | textbutton_element | imagebutton_element | text_element | conditional_element | other_element

imagemap_property: idle_property | ground_property | hover_property | alpha_property | generic_property

ground_property: GROUND string_expression

alpha_property: ALPHA BOOLEAN

// ============================================================================
// LAYOUT ELEMENTS: vbox, hbox (basic support)
// ============================================================================

layout_element: vbox_element | hbox_element

vbox_element: "vbox" layout_params? ":" layout_body
hbox_element: "hbox" layout_params? ":" layout_body

layout_params: layout_param+
layout_param: xpos_property | ypos_property | generic_property

// Position properties already defined above

layout_body: screen_element+

// ============================================================================
// TEXT ELEMENTS: Non-interactive text display
// ============================================================================

text_element: TEXT STRING text_properties?

text_properties: text_property+
text_property: xalign_property | yalign_property | xpos_property | ypos_property | generic_property

TEXT.2: "text"

// ============================================================================
// GENERIC ELEMENTS: Catch-all for other elements
// ============================================================================

other_element: IDENTIFIER generic_properties? (":" other_body)?

other_body: (generic_property | other_element)+

generic_properties: generic_property+
// generic_property already defined above

// ============================================================================
// LITERALS: String, number, list, boolean values
// ============================================================================

// String literals: Support both single and double quotes
STRING: ESCAPED_STRING | SINGLE_QUOTED_STRING

// List literals: [(1, "#808080", 0, 0)] or [1, 2, 3]
list_literal: "[" list_items? "]"
list_items: list_item ("," list_item)*
list_item: STRING | NUMBER | DECIMAL | coordinate_tuple | list_literal | BOOLEAN

// ============================================================================
// TOKENS: Terminal symbols
// ============================================================================

// Keywords (highest priority)
SCREEN.2: "screen"
IF.2: "if"
ELIF.2: "elif"
ELSE.2: "else"
TEXTBUTTON.2: "textbutton"
IMAGEBUTTON.2: "imagebutton"
BUTTON.2: "button"
HOTSPOT.2: "hotspot"
IMAGEMAP.2: "imagemap"
ADD.2: "add"
ACTION.2: "action"
CLICKED.2: "clicked"
JUMP.2: "Jump"
CALL.2: "Call"

// Property keywords (high priority)
AUTO.2: "auto"
IDLE.2: "idle"
HOVER.2: "hover"
FOCUS_MASK.2: "focus_mask"
AT.2: "at"
TOOLTIP.2: "tooltip"
XPOS.2: "xpos"
YPOS.2: "ypos"
XALIGN.2: "xalign"
YALIGN.2: "yalign"
XOFFSET.2: "xoffset"
YOFFSET.2: "yoffset"
ANCHOR.2: "anchor"
XYSIZE.2: "xysize"
XSIZE.2: "xsize"
YSIZE.2: "ysize"
MODAL.2: "modal"
ZORDER.2: "zorder"
GROUND.2: "ground"
ALPHA.2: "alpha"
HOVER_SOUND.2: "hover_sound"

// Boolean literals (high priority to match before IDENTIFIER)
BOOLEAN.2: "True" | "False"

// Identifiers: screen names, property names, etc.
// Medium priority
IDENTIFIER.1: /[a-zA-Z_][a-zA-Z0-9_]*/

// Numbers: integers and decimals
NUMBER: /\d+/
DECIMAL: /\d+\.\d+/ | /\.\d+/

// String tokens with proper escaping
ESCAPED_STRING: /"([^"\\]|\\.)*"/
SINGLE_QUOTED_STRING: /'([^'\\]|\\.)*'/

// Comments: ignore Python-style comments
COMMENT: /#[^\n]*/

// Newline handling for indentation  
// Capture newline + any following whitespace (including blank lines)
_NEWLINE: /\r?\n([\t ]*\r?\n)*[\t ]*/

// Ignore horizontal whitespace (spaces and tabs, but not newlines)
%ignore /[ \t]+/
%ignore COMMENT

// Declare indentation tokens
%declare _INDENT _DEDENT
