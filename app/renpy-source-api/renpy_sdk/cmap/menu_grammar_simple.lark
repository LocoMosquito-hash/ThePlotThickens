// Simplified CMAP Grammar - based on working minimal grammar

start: menu_definition

menu_definition: MENU menu_name? ":" menu_body

menu_name: IDENTIFIER

menu_body: menu_item+

menu_item: conditional_choice | simple_choice | menu_text | character_dialogue

// Menu text (descriptive text without colon)
menu_text: STRING

// Character dialogue in menu
character_dialogue: IDENTIFIER STRING

simple_choice: STRING ":" choice_body?

conditional_choice: STRING IF conditional_expression ":" choice_body?

conditional_expression: "not" IDENTIFIER
                      | IDENTIFIER comparison_operator condition_value
                      | IDENTIFIER
                      | TRUE
                      | FALSE
                      | NUMBER

comparison_operator: "==" | "!=" | "<" | ">" | "<=" | ">="

condition_value: STRING | NUMBER | IDENTIFIER | TRUE | FALSE

choice_body: statement+

statement: if_statement
         | jump_statement
         | call_statement  
         | return_statement
         | pass_statement
         | scene_statement
         | pause_statement
         | stop_statement
         | with_statement
         | dialogue_statement
         | empty_char_dialogue
         | python_block
         | inline_python

// If statement in choice body (e.g., "if True: jump label")
if_statement: IF conditional_expression ":" statement

jump_statement: JUMP IDENTIFIER

call_statement: CALL IDENTIFIER

return_statement: RETURN

pass_statement: PASS

// Scene statement (e.g., "scene bg_room", "scene bg_room with fade")
scene_statement: SCENE IDENTIFIER (WITH IDENTIFIER)?

// Pause statement (e.g., "pause", "pause 2.0", "pause 3")
pause_statement: PAUSE NUMBER?

// Stop statement (e.g., "stop music", "stop music fadeout 1.0")
stop_statement: STOP IDENTIFIER (FADEOUT NUMBER)?

// Standalone with statement (e.g., "with dissolve", "with fade")
with_statement: WITH IDENTIFIER

// Dialogue statement in choice body (e.g., 'A "Some text"')
dialogue_statement: IDENTIFIER STRING

// Empty character narrator dialogue (e.g., '"" "Some text"')
empty_char_dialogue: EMPTY_STRING STRING

// Python blocks - skip the content
python_block: PYTHON ":" python_content*

python_content: /[^\n\r]+/

// Inline Python statement (e.g., "$ dp +1", "$ my_var = True")
inline_python: "$" /[^\n\r]+/

// Terminals
// Keywords must have higher priority than IDENTIFIER using .priority notation
TRUE.2: "True"

FALSE.2: "False"

// Reserve keywords with high priority (priority 2 > default priority 0)
SCENE.2: "scene"
PAUSE.2: "pause"
STOP.2: "stop"
FADEOUT.2: "fadeout"
WITH.2: "with"
JUMP.2: "jump"
CALL.2: "call"
RETURN.2: "return"
PASS.2: "pass"
PYTHON.2: "python"
IF.2: "if"
MENU.2: "menu"

// IDENTIFIER has default priority (0), so keywords will match first
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/

// EMPTY_STRING must have higher priority than STRING to match "" before general strings
EMPTY_STRING.3: "\"\""

STRING: /"([^"\\]|\\.)*"/

NUMBER: /\d+\.?\d*/

// Whitespace and comments
%import common.WS
%ignore WS

COMMENT: /#[^\n\r]*/
%ignore COMMENT
